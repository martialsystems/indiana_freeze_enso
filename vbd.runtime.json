{
  "runtime_checks": [
    {
      "id": "unit-tests",
      "argv": [".venv/bin/python", "-m", "pytest", "tests/", "-q"],
      "timeout_s": 180,
      "paths": ["src/**", "tests/**", "scripts/**", "ensoforge/**", "requirements.txt", "vbd.runtime.json"]
    },
    {
      "id": "fixture-path",
      "argv": [".venv/bin/python", "scripts/run_fixture.py", "logs/stage0_fixture"],
      "timeout_s": 120,
      "paths": ["src/**", "scripts/**", "tests/**"]
    },
    {
      "id": "ensoforge-sanity",
      "argv": [".venv/bin/python", "ensoforge/scripts/sanity_ensoforge.py"],
      "timeout_s": 60,
      "paths": ["ensoforge/**", "tests/test_ensoforge_laws.py"]
    }
  ]
}
